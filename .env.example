# Copy to .env for local development. Every value is optional.

# Storage. Default: SQLite file at data/productpulse.db (fine locally; ephemeral on many hosts).
# For durable hosted storage use PostgreSQL, e.g.
# PRODUCTPULSE_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
PRODUCTPULSE_DATABASE_URL=

# Upload and analysis limits
PRODUCTPULSE_MAX_UPLOAD_MB=10
PRODUCTPULSE_MAX_IMPORT_ROWS=20000
PRODUCTPULSE_MAX_ANALYSIS_ROWS=6000

# Embeddings: auto | sentence-transformers | tfidf
PRODUCTPULSE_EMBEDDING_BACKEND=auto
PRODUCTPULSE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional LLM theme summaries: none | anthropic | openai (OpenAI-compatible endpoint)
PRODUCTPULSE_LLM_PROVIDER=none
PRODUCTPULSE_LLM_API_KEY=
PRODUCTPULSE_LLM_MODEL=
PRODUCTPULSE_LLM_BASE_URL=
PRODUCTPULSE_LLM_TIMEOUT_SECONDS=20

PRODUCTPULSE_LOG_LEVEL=INFO
